# ── 선택 사항 ─────────────────────────────────────────────
# 지금은 키 없이도 그대로 동작합니다 (localStorage + 로컬 문장 조합기).
# 아래 값은 Supabase에 연결할 때 .env.local 에 채워 넣으세요.
# Vercel / Cloudflare Pages 대시보드의 Environment variables에도 같은 이름으로 넣습니다.

# Supabase (ideas/timeline-mvp-schema.sql 적용 후)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# AI 문장을 서버에서 대신 호출할 때 (브라우저에 키를 노출하지 않는 권장 방식)
# Edge Function / Serverless Function 에만 넣고 VITE_ 접두사를 붙이지 마세요.
GEMINI_API_KEY=
